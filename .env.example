# Copy this file to .env and fill in real values. Never commit .env.

# Push alerts via ntfy.sh (optional, recommended). When NTFY_TOPIC is set,
# alerts go to https://ntfy.sh/<topic> instead of SMS. Subscribe to the
# same topic in the ntfy phone app. Anyone who knows the topic can read
# it, so make it long and random.
NTFY_TOPIC=
# NTFY_SERVER=https://ntfy.sh
# NTFY_TOKEN=

# SMS alerts via email-to-SMS carrier gateway (fallback when NTFY_TOPIC is
# unset; optional - only required
# if you want text alerts; the rest of the app works without this).
#
# EMAIL_SENDER_ADDRESS / EMAIL_APP_PASSWORD: a Gmail account to send
# from, with an App Password (not your real Gmail password) generated at
# https://myaccount.google.com/apppasswords
#
# NOTIFICATION_PHONE_NUMBER: your phone number, digits only, no dashes
# or country code (e.g. 4075551234)
#
# SMS_CARRIER_GATEWAY: your carrier's email-to-SMS domain, e.g.
#   Verizon:   vtext.com
#   AT&T:      txt.att.net
#   T-Mobile:  tmomail.net
EMAIL_SENDER_ADDRESS=
EMAIL_APP_PASSWORD=
NOTIFICATION_PHONE_NUMBER=
SMS_CARRIER_GATEWAY=
